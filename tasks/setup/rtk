#!/usr/bin/env bash
#MISE description="configure RTK integrations for Claude Code and Pi"
set -euo pipefail

if ! command -v rtk >/dev/null 2>&1; then
  echo "ERROR: rtk is not installed; run 'mise install rtk' first." >&2
  exit 1
fi

# mise can invoke this task from bootstrap/update before a new shell sources
# ~/.zshenv. Keep RTK's telemetry prompt disabled in that process too.
export RTK_TELEMETRY_DISABLED="${RTK_TELEMETRY_DISABLED:-1}"

# Claude's hook is transparent, so avoid modifying the copy-managed CLAUDE.md.
rtk init -g --hook-only --auto-patch

# Codex already receives the RTK instructions from the copy-managed
# home/.config/codex/AGENTS.md. Do not run `rtk init --codex` here: it mutates
# the live copy and makes the next mise dotfiles apply ask to overwrite it.

# Pi's extension is machine-local and transparent; it is safe to refresh.
rtk init -g --agent pi --auto-patch
