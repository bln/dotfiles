#!/usr/bin/env bash
#MISE description="create machine-local git identity files"
#MISE interactive=true
#USAGE flag "--force" help="Overwrite existing files (default: skip if present)"
set -euo pipefail

# Machine-local identity files, routed by remote in ~/.config/git/config:
#   identity-personal - default (no-remote repos, github.com, everything else)
#   identity-work     - selected when a remote points at github.tools.sap
personal="$HOME/.config/git/identity-personal"
work="$HOME/.config/git/identity-work"

# When run via `mise run`, USAGE_FORCE is set by mise's #USAGE parser.
# When invoked directly (e.g. in tests), set USAGE_FORCE=true to force overwrite.
force="${USAGE_FORCE:-false}"

# Guard on the default file - it must always resolve, so it is the one that
# gates a re-run into a no-op.
if [ -f "$personal" ] && [ "$force" != "true" ]; then
  # shellcheck disable=SC2088 # literal path shown to the user, not a path to expand
  echo "~/.config/git/identity-personal already exists (pass --force to overwrite)."
  exit 0
fi

prompt_required() {
  label="$1"
  printf '%s' "$label" >&2
  IFS= read -r value
  if [ -z "$value" ]; then
    echo "ERROR: ${label%: } is required" >&2
    exit 2
  fi
  printf '%s\n' "$value"
}

prompt_email() {
  label="$1"
  value="$(prompt_required "$label")"
  case "$value" in
    *@*.*) printf '%s\n' "$value" ;;
    *) echo "ERROR: ${label%: } must look like an email address" >&2; exit 2 ;;
  esac
}

# Write a [user] block literally - printf %s preserves any metacharacters in the
# name/email (no template substitution, so no & / {{ }} escaping needed).
write_identity() {
  local file="$1" name="$2" email="$3"
  printf '[user]\n\tname = %s\n\temail = %s\n' "$name" "$email" > "$file"
  chmod 600 "$file"
}

personal_name="$(prompt_required 'Personal (github.com) git name:  ')"
personal_email="$(prompt_email 'Personal (github.com) git email: ')"
work_name="$(prompt_required 'Work (github.tools.sap) git name:  ')"
work_email="$(prompt_email 'Work (github.tools.sap) git email: ')"

mkdir -p "$HOME/.config/git"
write_identity "$personal" "$personal_name" "$personal_email"
write_identity "$work" "$work_name" "$work_email"

echo
echo "Created ~/.config/git/identity-personal"
echo "  personal: $personal_name <$personal_email>"
echo "Created ~/.config/git/identity-work"
echo "  work:     $work_name <$work_email>"
