#!/usr/bin/env bash
#MISE description="remove RTK integrations for Claude Code, Codex, and Pi"
set -euo pipefail

if command -v rtk >/dev/null 2>&1; then
  rtk init -g --hook-only --uninstall
  rtk init -g --codex --uninstall
  rtk init -g --agent pi --uninstall
else
  echo "rtk not installed; nothing to teardown." >&2
fi
