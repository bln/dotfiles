# ── repo artifacts ────────────────────────────────────────────────────────────
FINDINGS.md
backup/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# ── editors ───────────────────────────────────────────────────────────────────
# Vim
*.swp
*.swo
*~
# Backups (e.g. rtk --uninstall leaves settings.json.bak / hooks.json.bak in
# machine-local agent roots; never track a .bak anywhere in the tree).
*.bak
# JetBrains
.idea/
# VS Code
.vscode/

# ── common build / runtime artifacts ──────────────────────────────────────────
node_modules/
__pycache__/
*.py[cod]
.venv/
dist/
build/

# ── secrets / local overrides ─────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample

# machine-local files - never commit
home/.config/git/config.local
home/.config/zsh/.zshrc.local
home/mise.local.toml

# Agent runtime roots are machine-local. Only the explicit instruction file,
# repo-owned extension, and skill trees below are repository resources.
# Credentials, settings, sessions, databases, caches, plugins, and other agent
# state stay local.
home/.agents/
home/.config/pi/**
!home/.config/pi/agent/
!home/.config/pi/agent/AGENTS.md
!home/.config/pi/agent/extensions/
!home/.config/pi/agent/extensions/friendly-footer.ts
home/.config/codex/**
!home/.config/codex/AGENTS.md
home/.config/skills/**
!home/.config/skills/
!home/.config/skills/**
home/.config/claude/**
!home/.config/claude/
!home/.config/claude/CLAUDE.md
!home/.config/claude/skills/
!home/.config/claude/skills/**

# mise writes a lockfile next to the repo-local mise.toml; the tracked
# lockfile is home/.config/mise/mise.lock, so ignore this generated one.
/mise.lock

# PKM app state (repo opened as Obsidian/Octarine vault)
.obsidian/
.octarine/
