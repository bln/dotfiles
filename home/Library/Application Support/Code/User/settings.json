{
  // Chat and AI
  "chat.disableAIFeatures": true,
  "claudeCode.preferredLocation": "panel",

  // Typography
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": "'calt', 'liga'",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 14,

  // Editor behavior
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [100],
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.renderWhitespace": "boundary",
  "editor.guides.bracketPairs": "active",
  "editor.suggest.preview": true,
  "editor.suggestSelection": "first",
  "editor.linkedEditing": true,
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.bracketPairColorization.enabled": true,
  "editor.stickyScroll.enabled": true,

  // Workbench
  "workbench.colorTheme": "Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.editor.tabSizing": "shrink",
  "workbench.tree.indent": 16,
  "workbench.sideBar.location": "right",

  // Files
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.eol": "auto",
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/dist": true,
    "**/build": true
  },
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,

  // Explorer and workspace safety
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "security.workspace.trust.enabled": true,

  // Integrated terminal. The bottom panel remains in its default position.
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.confirmOnExit": "hasChildProcesses",

  // Source control
  "git.confirmSync": true,
  "git.enableSmartCommit": false,
  "git.pruneOnFetch": true,

  // Let VS Code manage extensions and updates
  "extensions.autoCheckUpdates": true,
  "extensions.autoUpdate": "on",

  // Privacy
  "telemetry.telemetryLevel": "off"
}
