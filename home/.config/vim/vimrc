" Minimal, plugin-free Vim configuration.
scriptencoding utf-8
set encoding=utf-8

" Built-in filetype support.
filetype plugin indent on
syntax on

" Catppuccin Frappé.
if exists('+termguicolors')
  set termguicolors
endif
colorscheme catppuccin-frappe

" Editing behavior.
set hidden
set number
set relativenumber
set cursorline
set ruler
set showmatch
set nowrap
set scrolloff=8
set sidescrolloff=8

" Two-space indentation.
set tabstop=2
set shiftwidth=2
set softtabstop=2
set expandtab
set autoindent

" Search and command-line completion.
set ignorecase
set smartcase
set incsearch
set hlsearch
set wildmenu
set wildmode=longest:full,full
set history=1000

" Convenient built-in terminal behavior.
set splitbelow
set splitright
set mouse=a
set clipboard=unnamedplus
