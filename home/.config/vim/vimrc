" ~/.config/vim/vimrc
" Basic, plugin-free Vim configuration.

set nocompatible
filetype plugin indent on
syntax enable
colorscheme mini-onedark

set number
set tabstop=2
set shiftwidth=2
set expandtab
set smartindent

set ignorecase
set smartcase
set incsearch
set backspace=indent,eol,start
set mouse=a
set clipboard=unnamedplus
