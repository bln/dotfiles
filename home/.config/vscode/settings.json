{
  // ── chat & AI ──────────────────────────────────────────────────────────────
  "chat.fontSize": 16,
  "claudeCode.preferredLocation": "panel",
  // ── typography & fonts ─────────────────────────────────────────────────────
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Menlo, monospace",
  "editor.fontSize": 16,
  "editor.lineHeight": 1.6,
  "editor.fontLigatures": "'calt', 'liga'",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 16,
  // ── editor behavior ────────────────────────────────────────────────────────
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.rulers": [
    100
  ],
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.renderWhitespace": "boundary",
  "editor.guides.bracketPairs": true,
  "editor.suggest.preview": true,
  "editor.linkedEditing": true,
  "editor.inlayHints.enabled": "onUnlessPressed",
  // ── workbench & theme ──────────────────────────────────────────────────────
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "One Dark Pro",
  "workbench.preferredLightColorTheme": "One Dark Pro",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.tree.indent": 16,
  "workbench.sideBar.location": "right",
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor",
    "*.html": "workbench.editor.browser"
  },
  // ── window & security ──────────────────────────────────────────────────────
  "markdown.preview.doubleClickToSwitchToEditor": true,
  "markdown.preview.scrollEditorWithPreview": true,
  "markdown.preview.scrollPreviewWithEditor": true,
  // ── window & security ──────────────────────────────────────────────────────
  "window.titleBarStyle": "custom",
  "security.workspace.trust.enabled": false,
  // ── files & excludes ───────────────────────────────────────────────────────
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true
  },
  // ── terminal ───────────────────────────────────────────────────────────────
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.enableImages": true,
  "terminal.integrated.automationProfile.osx": {
    "path": "/usr/bin/zsh",
    "args": [
      "--login"
    ]
  },
  // ── git & diffs ────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.pruneOnFetch": true,
  "git.openRepositoryInParentFolders": "always",
  "diffEditor.ignoreTrimWhitespace": true,
  // ── language-specific configurations ────────────────────────────────────────
  // Python (Pylance + debugpy)
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.indexing": true,
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.formatOnSave": true
  },
  // Go (golang.go)
  "[go]": {
    "editor.insertSpaces": false,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  // Document Authoring (Typst & Marp)
  "[typst]": {
    "editor.defaultFormatter": "myriad-dreamer.typst-lsp",
    "editor.wordWrap": "on"
  },
  "markdown.marp.enableHTML": true,
  // CSV & Data Formatting
  "rainbow_csv.enable_rainbow_csv_autodetect": true,
  // ── explorer & search ──────────────────────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "search.exclude": {
    "**/dist": true,
    "**/.git": true,
    "**/build": true
  },
  // ── telemetry & updates ────────────────────────────────────────────────────
  "telemetry.telemetryLevel": "off",
  "extensions.autoCheckUpdates": false,
  "makefile.configureOnOpen": false,
  "python.languageServer": "Default"
}
