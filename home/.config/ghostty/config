# ── font ──────────────────────────────────────────────────────────────────────
font-family = JetBrainsMono Nerd Font
font-size = 16
font-thicken = true

# ── theme ─────────────────────────────────────────────────────────────────────
theme = mini-onedark
background-opacity = 0.95
background-blur-radius = 20
window-colorspace = display-p3

# ── window ────────────────────────────────────────────────────────────────────
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 10

# ── cursor ────────────────────────────────────────────────────────────────────
# Use a standard full-cell cursor and keep it blinking at the command prompt.
#cursor-style = block
cursor-style-blink = true

# ── shell ─────────────────────────────────────────────────────────────────────
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title

# ── clipboard ─────────────────────────────────────────────────────────────────
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-read = allow

# ── behaviour ─────────────────────────────────────────────────────────────────
mouse-hide-while-typing = true
macos-option-as-alt = true
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never
grapheme-width-method = unicode
link-url = true
link-previews = true

# ── keybindings ───────────────────────────────────────────────────────────────
keybind = cmd+enter=toggle_fullscreen
keybind = cmd+d=new_split:down
keybind = cmd+shift+d=new_split:right
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom
#keybind = ctrl+shift+,=text:ghostty +edit-config\n
keybind = unconsumed:super+,=text:\x1bqghostty +edit-config\x0d
