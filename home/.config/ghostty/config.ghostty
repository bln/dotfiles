# ── font ──────────────────────────────────────────────
font-size = 16
font-thicken = true

# ── appearance ────────────────────────────────────────
theme = mini-onedark
background-opacity = 0.95
background-blur-radius = 20

# ── window ────────────────────────────────────────────
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 10

# ── cursor ────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── clipboard / input ─────────────────────────────────
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
macos-option-as-alt = true

# ── behaviour ─────────────────────────────────────────
mouse-hide-while-typing = true
confirm-close-surface = false
quit-after-last-window-closed = true
resize-overlay = never
link-previews = true

# ── accessibility ─────────────────────────────────────
minimum-contrast = 1.5

# ── keybindings ───────────────────────────────────────
keybind = cmd+enter=toggle_fullscreen

keybind = cmd+d=new_split:down
keybind = cmd+shift+d=new_split:right

keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom

keybind = global:cmd+grave_accent=toggle_quick_terminal
