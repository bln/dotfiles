{
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "title_bar": {
    "show_sign_in": false,
  },
  "diff_view_style": "unified",
  "suggest_extensions": false,
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enabled": false,
  },
  "tabs": {
    "git_status": true,
  },
  "markdown_preview": {
    "open_markdown_files_in_preview": true,
  },
  "languages": {
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
    },
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": true,
  },
  "line_indicator_format": "short",
  "search": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "preferred_line_length": 100,
  "horizontal_scroll_margin": 8,
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": ["Menlo"],
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "file_scan_exclusions": [
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.venv",
    "**/__pycache__",
    "**/node_modules",
    "...",
  ],
  "show_whitespaces": "boundary",
  "use_smartcase_search": true,
  "format_on_save": "on",
  "wrap_guides": [100],
  "tab_size": 2,
  "vertical_scroll_margin": 8,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Frappé",
  },
}
