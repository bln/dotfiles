# Keep identities in machine-local files; useConfigOnly prevents Git from
# guessing when no identity has been configured.
[user]
	useConfigOnly = true

[include]
	path = ~/.config/git/identity-personal
	path = ~/.config/git/identity-local

[core]
	pager = delta
	autocrlf = input
	whitespace = -indent-with-non-tab,trailing-space,cr-at-eol
	precomposeunicode = true
	trustctime = false

[interactive]
	diffFilter = delta --color-only

[credential "https://github.com"]
	helper = osxkeychain
[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true
	prunetags = true

[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true

[merge]
	conflictstyle = zdiff3
	ff = only

[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
	renames = copies

[delta]
	navigate = true
	line-numbers = true
	dark = true
	syntax-theme = OneHalfDark

[commit]
	verbose = true

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

[status]
	showUntrackedFiles = all

[log]
	date = iso-local

[column]
	ui = auto

[transfer]
	fsckObjects = true

[rerere]
	enabled = true
	autoupdate = true

[help]
	autocorrect = prompt

[alias]
	# status / inspection
	ci     = commit
	st     = status
	s      = status -sb
	l      = log --oneline --graph --decorate --all
	ll     = log --oneline --graph --decorate -20
	lg     = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	tree   = log --graph --all --decorate --oneline --date-order
	remotes = remote --verbose
	tags   = tag -l
	branches = branch --all
	show-files = diff-tree --no-commit-id --name-only -r

	# branching
	main-branch = "!b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) && echo ${b#origin/} || echo main"
	b      = branch -vv
	co     = checkout
	cob    = checkout -b
	sw     = switch
	swc    = switch -c

	# staging / committing
	a      = add -p
	aa     = add -A
	c      = commit
	ca     = commit --amend
	can    = commit --amend --no-edit

	# syncing
	f      = fetch --all
	pu     = push -u origin HEAD
	fpush  = push --force-with-lease --force-if-includes

	# stash
	ss     = stash push -u -m
	sp     = stash pop

	# cleanup
	gone   = "!git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" {print $1}' | grep . | xargs git branch -D"
	trim   = "!git fetch --prune && git gone"

	# utilities
	root   = rev-parse --show-toplevel
	whoami = "!git config user.name && git config user.email"
	aliases = "!git config --get-regexp '^alias\\.' | sed 's/alias\\.//'"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
