[user]
	useConfigOnly = true

[include]
	path = ~/.config/git/identity-personal
	path = ~/.config/git/identity-local

[core]
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[merge]
	conflictstyle = diff3
	ff = only

[diff]
	algorithm = histogram
	colorMoved = default

[commit]
	verbose = true

[alias]
	s = status -sb
	l = log --oneline --graph --decorate -20
