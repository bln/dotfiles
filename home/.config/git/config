# Mise renders machine-local identity files; useConfigOnly prevents Git from guessing.
[user]
	useConfigOnly = true

[include]
	path = ~/.config/git/identity-personal

[includeIf "hasconfig:remote.*.url:https://github.tools.sap/**"]
	path = ~/.config/git/identity-work
[includeIf "hasconfig:remote.*.url:ssh://*github.tools.sap/**"]
	path = ~/.config/git/identity-work
[includeIf "hasconfig:remote.*.url:git@github.tools.sap:*/**"]
	path = ~/.config/git/identity-work

[core]
	editor = vim
	autocrlf = input

[credential "https://github.com"]
	helper = osxkeychain
[credential "https://github.tools.sap"]
	helper = osxkeychain

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[fetch]
	prune = true

[merge]
	ff = only

[commit]
	template = ~/.config/git/commit-template

	[alias]
  ci = commit
  co = checkout
  st = status
  s = status --short --branch
  l = log -M --stat --abbrev-commit --graph
  lg = log --pretty=oneline -n 20 --graph --abbrev-commit
  tree = log --graph --all --decorate --oneline --date-order
  remotes = remote --verbose
  tags = tag -l
  branches = branch --all
